RunService.RenderStepped:Connect(function(dt)
	elapsedClock = elapsedClock + (isNum(dt) and dt or 0.016)
	pcall(function()
		if Config.AutoSeatToggle then
			local c = LocalPlayer.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			local seat = h and (h.Sit or (h.SeatPart ~= nil))
			if seat ~= pausedByVehicle then
				pausedByVehicle = seat
				Config.Enabled = userDesiredEnabled and not pausedByVehicle
				refreshUI()
			end
		end

		local cam = Workspace.CurrentCamera
		local c = LocalPlayer.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		local origin = (hrp and isVec3(hrp.Position)) and hrp.Position or (cam and cam.CFrame.Position)

		if elapsedClock - lastEspRenderTime >= 0.02 then
			lastEspRenderTime = elapsedClock
			updateESP(cam, origin)
		end

		CachedTarget = usesSilentAim() and findTarget("Aim", Config.FOVRadius, Config.WallCheck) or nil
		CachedChestTarget = usesChestAimbot() and findTarget("Chest", Config.AimbotFOVRadius, Config.AimbotWallCheck) or nil

		CachedAimPos = nil
		if CachedTarget and isVec3(CachedTarget.Position) then
			local pos = CachedTarget.Position
			if not Config.StraightBullet and Config.AutoSmartAim and isVec3(origin) then
				local vel = CachedTarget.AssemblyLinearVelocity
				if isVec3(vel) and vel.Magnitude > 2.5 then
					local lead = math.clamp(((pos - origin).Magnitude / math.max(350, Config.BulletSpeed)) * 0.75, 0, Config.MaxLeadTime)
					pos = pos + vel * lead
				end
			end
			CachedAimPos = pos
		end

		if CachedChestTarget and isVec3(CachedChestTarget.Position) and isFiringInputHeld and cam then
			local cf = cam.CFrame
			local dir = CachedChestTarget.Position - cf.Position
			if dir.Magnitude > 1e-4 then
				local goal = CFrame.lookAt(cf.Position, cf.Position + dir.Unit)
				cam.CFrame = Config.AimbotStickiness >= 100 and goal or cf:Lerp(goal, math.clamp((Config.AimbotStickiness / 100) * 0.65, 0.06, 0.65))
			end
		end

		if Config.TriggerBot and not pausedByVehicle and cam and elapsedClock - lastTriggerFireTime >= 0.15 then
			local vp = cam.ViewportSize
			local sp = CachedTarget and cam:WorldToViewportPoint(CachedTarget.Position) or (CachedChestTarget and cam:WorldToViewportPoint(CachedChestTarget.Position))
			if sp and sp.Z > 0 and math.hypot(sp.X - vp.X * 0.5, sp.Y - vp.Y * 0.5) <= Config.TriggerFOVRadius then
				lastTriggerFireTime = elapsedClock
				local tool = c and c:FindFirstChildOfClass("Tool")
				if tool and type(tool.Activate) == "function" then pcall(function() tool:Activate() end) end
			end
		end
	end)
end)

