local function rebuildPlayers()
	table.clear(PlayerCharacterSet)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then PlayerCharacterSet[plr.Character] = true end
	end
end

local function isEnemy(plr)
	if plr == LocalPlayer then return false end
	if Config.TeamCheck and LocalPlayer.Team and plr.Team == LocalPlayer.Team then return false end
	local c = plr.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return c and c.Parent and h and h.Health > 0
end

local function isWallBlocked(model, part, wallFlag)
	if not wallFlag or not part or not isVec3(part.Position) then return false end
	local cam = Workspace.CurrentCamera
	if not cam or not isVec3(cam.CFrame.Position) then return false end
	local delta = part.Position - cam.CFrame.Position
	if delta.Magnitude <= 0.01 then return false end
	SharedWallParams.FilterDescendantsInstances = { LocalPlayer.Character, model }
	local ok, res = pcall(function() return Workspace:Raycast(cam.CFrame.Position, delta, SharedWallParams) end)
	return ok and res and res.Instance and res.Instance.Transparency < 0.92
end

local function getEspSlot(idx)
	if EspVisualPool[idx] then return EspVisualPool[idx] end
	if not ESPContainer then return nil end

	local box = Instance.new("Frame")
	box.BackgroundTransparency = 1
	box.Visible = false
	box.Active = false
	box.Parent = ESPContainer
	local st = Instance.new("UIStroke")
	st.Thickness = 1.5
	st.Parent = box

	local hpBg = Instance.new("Frame")
	hpBg.BackgroundColor3 = Color3.fromRGB(15, 16, 20)
	hpBg.BackgroundTransparency = 0.25
	hpBg.BorderSizePixel = 0
	hpBg.Visible = false
	hpBg.Active = false
	hpBg.Parent = ESPContainer

	local hpFill = Instance.new("Frame")
	hpFill.BorderSizePixel = 0
	hpFill.Size = UDim2.new(1, 0, 1, 0)
	hpFill.Active = false
	hpFill.Parent = hpBg

	local dist = Instance.new("TextLabel")
	dist.BackgroundTransparency = 1
	dist.TextColor3 = Color3.fromRGB(245, 248, 255)
	dist.TextStrokeTransparency = 0.2
	dist.Font = Enum.Font.GothamBold
	dist.TextSize = 11
	dist.Visible = false
	dist.Active = false
	dist.Parent = ESPContainer

	EspVisualPool[idx] = { box = box, stroke = st, hpBg = hpBg, hpFill = hpFill, dist = dist }
	return EspVisualPool[idx]
end

local function hideEspFrom(startIdx)
	for i = startIdx, #EspVisualPool do
		local s = EspVisualPool[i]
		if s then s.box.Visible = false s.hpBg.Visible = false s.dist.Visible = false end
	end
end

local function updateESP(cam, origin)
	if not Config.ESPEnabled or not cam or not isVec3(origin) then hideEspFrom(1) return end
	local vp = cam.ViewportSize
	if vp.X <= 0 or vp.Y <= 0 then hideEspFrom(1) return end

	rebuildPlayers()
	local list = {}
	if shouldPlayers() then
		for _, plr in ipairs(Players:GetPlayers()) do
			if isEnemy(plr) then
				table.insert(list, { model = plr.Character, hum = plr.Character:FindFirstChildOfClass("Humanoid") })
			end
		end
	end
	if shouldNpcs() then
		for _, e in ipairs(CachedNpcEntries) do
			if e.model and e.model.Parent and not PlayerCharacterSet[e.model] and e.hum and e.hum.Health > 0 then
				table.insert(list, e)
			end
		end
	end

	local idx = 0
	for _, item in ipairs(list) do
		local hrp = item.model:FindFirstChild("HumanoidRootPart") or item.model:FindFirstChild("Head")
		if hrp and hrp:IsA("BasePart") and isVec3(hrp.Position) then
			local studs = (hrp.Position - origin).Magnitude
			local meters = math.floor(studs * 0.28 + 0.5)
			if math.max(studs, meters) <= Config.ESPMaxDistance then
				local top = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.8, 0))
				local bot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.1, 0))
				if (top.Z > 0 or bot.Z > 0) and isNum(top.X) and isNum(top.Y) and isNum(bot.X) and isNum(bot.Y) then
					local h = math.clamp(math.abs(bot.Y - top.Y), 14, vp.Y * 0.9)
					local w = math.clamp(h * 0.56, 10, vp.X * 0.6)
					local left = math.floor((top.X + bot.X) * 0.5 - w * 0.5)
					local topY = math.floor(math.min(top.Y, bot.Y))
					idx = idx + 1
					local slot = getEspSlot(idx)
					if slot then
						local blocked = Config.ESPWallCheck and isWallBlocked(item.model, hrp, true)
						slot.box.Position = UDim2.new(0, left, 0, topY)
						slot.box.Size = UDim2.new(0, math.floor(w), 0, math.floor(h))
						slot.stroke.Color = blocked and Color3.fromRGB(245, 248, 255) or Color3.fromRGB(55, 235, 115)
						slot.box.Visible = Config.ESPBox

						if Config.ESPHealthBar then
							local ratio = math.clamp((item.hum.Health or 0) / math.max(1, item.hum.MaxHealth or 100), 0, 1)
							slot.hpBg.Position = UDim2.new(0, left - 7, 0, topY)
							slot.hpBg.Size = UDim2.new(0, 4, 0, math.floor(h))
							slot.hpFill.Size = UDim2.new(1, 0, ratio, 0)
							slot.hpFill.Position = UDim2.new(0, 0, 1 - ratio, 0)
							slot.hpFill.BackgroundColor3 = ratio > 0.6 and Color3.fromRGB(65, 230, 105) or (ratio >= 0.3 and Color3.fromRGB(255, 155, 35) or Color3.fromRGB(255, 50, 60))
							slot.hpBg.Visible = true
						else
							slot.hpBg.Visible = false
						end

						if Config.ESPDistance then
							slot.dist.Text = tostring(meters) .. "m"
							slot.dist.Position = UDim2.new(0, left, 0, topY + math.floor(h) + 2)
							slot.dist.Size = UDim2.new(0, math.floor(w), 0, 14)
							slot.dist.Visible = true
						else
							slot.dist.Visible = false
						end
					end
				end
			end
		end
	end
	hideEspFrom(idx + 1)
end

local function pickPart(model, mode)
	if not model then return nil end
	local head = model:FindFirstChild("Head")
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
	if mode == "Chest" then return torso or head end
	if mode == "Random" and head and torso then
		return (math.random(1, 100) <= Config.HeadshotChance) and head or torso
	end
	local chosen = model:FindFirstChild(Config.TargetPart)
	return (chosen and chosen:IsA("BasePart") and chosen) or head or torso
end

local function findTarget(mode, fovLimit, wallFlag)
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local vp = cam.ViewportSize
	local cx, cy = vp.X * 0.5, vp.Y * 0.5
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local origin = (hrp and isVec3(hrp.Position)) and hrp.Position or cam.CFrame.Position
	local best, bestDist = nil, fovLimit

	rebuildPlayers()
	local list = {}
	if shouldPlayers() then
		for _, plr in ipairs(Players:GetPlayers()) do
			if isEnemy(plr) then
				table.insert(list, { model = plr.Character, hum = plr.Character:FindFirstChildOfClass("Humanoid") })
			end
		end
	end
	if shouldNpcs() then
		if elapsedClock - lastNpcScanTime >= 1.2 and not isScanningNpc then
			lastNpcScanTime = elapsedClock
			isScanningNpc = true
			task.spawn(function()
				local out = {}
				pcall(function()
					for _, o in ipairs(Workspace:GetChildren()) do
						if o:IsA("Model") and o ~= LocalPlayer.Character and not PlayerCharacterSet[o] then
							local h = o:FindFirstChildOfClass("Humanoid")
							if h and h.Health > 0 then table.insert(out, { model = o, hum = h }) end
						end
					end
				end)
				CachedNpcEntries = out
				isScanningNpc = false
			end)
		end
		for _, e in ipairs(CachedNpcEntries) do
			if e.model and e.model.Parent and not PlayerCharacterSet[e.model] and e.hum and e.hum.Health > 0 then
				table.insert(list, e)
			end
		end
	end

	for _, item in ipairs(list) do
		local p = pickPart(item.model, mode)
		if p and p:IsA("BasePart") and isVec3(p.Position) then
			local d3 = (p.Position - origin).Magnitude
			if Config.MaxDistance <= 0 or d3 <= Config.MaxDistance then
				local okAng = true
				if Config.SafeAngleClamp and d3 > 14 then
					local dot = math.clamp(cam.CFrame.LookVector.Unit:Dot((p.Position - cam.CFrame.Position).Unit), -1, 1)
					okAng = math.deg(math.acos(dot)) <= (Config.MaxSafeAngleDeg or 28)
				end
				if okAng then
					local sp, onScr = cam:WorldToViewportPoint(p.Position)
					if onScr and sp.Z > 0 and isNum(sp.X) and isNum(sp.Y) then
						local d2 = math.hypot(sp.X - cx, sp.Y - cy)
						if d2 <= math.min(bestDist, fovLimit) and not isWallBlocked(item.model, p, wallFlag) then
							best = p
							bestDist = d2
						end
					end
				end
			end
		end
	end
	return best
end

