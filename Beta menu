local function switchTab(name)
	Config.ActiveTab = name
	for k, p in pairs(PageFrames) do
		if p then p.Visible = (k == name) end
	end
	for k, b in pairs(TabButtons) do
		if b then
			local sel = (k == name)
			b.TextColor3 = sel and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(165, 170, 180)
			b.BackgroundColor3 = sel and Color3.fromRGB(48, 52, 58) or Color3.fromRGB(32, 34, 38)
		end
	end
end

local function applyMin()
	if not MainFrame then return end
	if isMinimized then
		if TopBar then TopBar.Visible = false end
		if TabBar then TabBar.Visible = false end
		for _, p in pairs(PageFrames) do if p then p.Visible = false end end
		if HButton then HButton.Visible = true end
		MainFrame.BackgroundTransparency = 1
		MainFrame.Size = UDim2.new(0, 42, 0, 42)
	else
		if HButton then HButton.Visible = false end
		if TopBar then TopBar.Visible = true end
		if TabBar then TabBar.Visible = true end
		MainFrame.BackgroundTransparency = 0
		MainFrame.Size = UDim2.new(0, 340, 0, 248)
		switchTab(Config.ActiveTab)
	end
end

