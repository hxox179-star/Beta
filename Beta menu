pcall(function()
	if not getnamecallmethod or not hookmetamethod then return end
	local oldNc
	oldNc = hookmetamethod(game, "__namecall", function(self, ...)
		local method = getnamecallmethod()
		if Config.AntiKickClient and method == "Kick" and self == LocalPlayer then return nil end
		if usesSilentAim() and self == Workspace and CachedAimPos and (not checkcaller or not checkcaller()) then
			if method == "Raycast" then
				local args = { ... }
				if isVec3(args[1]) and isVec3(args[2]) then
					local d = CachedAimPos - args[1]
					if d.Magnitude > 1e-5 then args[2] = d.Unit * args[2].Magnitude end
					return oldNc(self, table.unpack(args))
				end
			elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
				local args = { ... }
				local r = args[1]
				if typeof(r) == "Ray" and isVec3(r.Origin) and isVec3(r.Direction) then
					local d = CachedAimPos - r.Origin
					if d.Magnitude > 1e-5 then args[1] = Ray.new(r.Origin, d.Unit * r.Direction.Magnitude) end
					return oldNc(self, table.unpack(args))
				end
			end
		end
		return oldNc(self, ...)
	end)
end)

pcall(function()
	local m = LocalPlayer:GetMouse()
	if not m or not hookmetamethod then return end
	local oldIdx
	oldIdx = hookmetamethod(m, "__index", function(self, k)
		if usesSilentAim() and self == m and CachedAimPos and (not checkcaller or not checkcaller()) then
			if k == "Hit" then return CFrame.new(CachedAimPos) end
			if k == "Target" and CachedTarget then return CachedTarget end
			if k == "UnitRay" then
				local cam = Workspace.CurrentCamera
				if cam and isVec3(cam.CFrame.Position) then
					local d = CachedAimPos - cam.CFrame.Position
					if d.Magnitude > 1e-5 then return Ray.new(cam.CFrame.Position, d.Unit) end
				end
			end
		end
		return oldIdx(self, k)
	end)
end)
