local function isNum(n)
	return typeof(n) == "number" and n == n and math.abs(n) ~= math.huge
end

local function isVec3(v)
	return typeof(v) == "Vector3" and isNum(v.X) and isNum(v.Y) and isNum(v.Z)
end

local function cycle(list, cur, fb)
	for i, v in ipairs(list) do
		if v == cur then return list[(i % #list) + 1] end
	end
	return fb
end

local function setStatus(msg, ok)
	if SaveStatusLabel then
		SaveStatusLabel.Text = tostring(msg)
		SaveStatusLabel.TextColor3 = ok and Color3.fromRGB(150, 240, 130) or Color3.fromRGB(255, 165, 95)
	end
end

local function cleanName(raw)
	local s = tostring(raw or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("[^%w%-%_]", "_")
	return s == "" and "Default" or s
end

local function saveConfig(raw)
	local name = cleanName(raw)
	Config.SaveName = name
	local snap = {}
	for k in pairs(getDefaultConfig()) do snap[k] = Config[k] end
	MemorySaves[name] = snap
	if type(writefile) == "function" then
		pcall(function()
			if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(SAVE_FOLDER) then
				makefolder(SAVE_FOLDER)
			end
			local lines = { "return {" }
			for k, v in pairs(snap) do
				if typeof(v) == "boolean" or typeof(v) == "number" then
					table.insert(lines, string.format("[%q]=%s,", k, tostring(v)))
				elseif typeof(v) == "string" then
					table.insert(lines, string.format("[%q]=%q,", k, v))
				end
			end
			table.insert(lines, "}")
			writefile(SAVE_FOLDER .. "/" .. name .. ".lua", table.concat(lines))
		end)
	end
	setStatus("Đã lưu: " .. name, true)
end

local function loadConfig(raw)
	local name = cleanName(raw)
	if type(readfile) == "function" and type(isfile) == "function" and type(loadstring) == "function" then
		local path = SAVE_FOLDER .. "/" .. name .. ".lua"
		local okEx, ex = pcall(isfile, path)
		if okEx and ex then
			local okR, src = pcall(readfile, path)
			local fn = okR and loadstring(src)
			local okRun, tbl = pcall(fn)
			if type(fn) == "function" and okRun and type(tbl) == "table" then
				for k, dv in pairs(getDefaultConfig()) do
					if tbl[k] ~= nil and typeof(tbl[k]) == typeof(dv) then Config[k] = tbl[k] end
				end
				Config.SaveName = name
				userDesiredEnabled = Config.Enabled
				setStatus("Đã tải: " .. name, true)
				return
			end
		end
	end
	if MemorySaves[name] then
		for k, v in pairs(MemorySaves[name]) do Config[k] = v end
		Config.SaveName = name
		userDesiredEnabled = Config.Enabled
		setStatus("Đã tải: " .. name, true)
		return
	end
	setStatus("Không thấy save: " .. name, false)
end

